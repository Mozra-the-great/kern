{
	"name": "kern-ui",
	"version": "0.1.0",
	"description": "Svelte 5 component kit with brand themes set by CSS variables, also shipped as custom elements.",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./themes.css": "./dist/themes/index.css",
		"./themes/*": "./dist/themes/*",
		"./elements": "./dist-elements/kern-elements.js"
	},
	"files": [
		"dist",
		"dist-elements"
	],
	"sideEffects": [
		"**/*.css",
		"./dist-elements/*"
	],
	"scripts": {
		"dev": "vite",
		"build": "npm run package && npm run build:elements && npm run build:demo",
		"package": "svelte-package -i src/lib -o dist",
		"build:elements": "vite build -c vite.elements.config.ts",
		"build:demo": "vite build",
		"check": "svelte-check --tsconfig ./tsconfig.json"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^2.5.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"typescript": "^5.9.3",
		"vite": "^8.3.8"
	}
}
