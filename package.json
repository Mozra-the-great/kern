{
	"name": "@mozra-the-great/kern",
	"version": "0.2.0",
	"description": "Svelte 5 component kit with brand themes set by CSS variables, also shipped as custom elements.",
	"license": "GPL-3.0-or-later",
	"author": "Mozra-the-great",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Mozra-the-great/kern.git"
	},
	"homepage": "https://mozra-the-great.github.io/kern/",
	"bugs": {
		"url": "https://github.com/Mozra-the-great/kern/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./themes.css": "./dist/themes/index.css",
		"./themes/base.css": "./dist/themes/base.css",
		"./themes/stuffcloud.css": "./dist/themes/stuffcloud.css",
		"./themes/flower.css": "./dist/themes/flower.css",
		"./themes/pop.css": "./dist/themes/pop.css",
		"./themes/*": "./dist/themes/*",
		"./elements": "./dist-elements/kern-elements.js",
		"./assets/*": "./assets/*",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"dist-elements",
		"assets",
		"NOTICE",
		"CHANGELOG.md"
	],
	"sideEffects": [
		"**/*.css",
		"./dist-elements/*"
	],
	"scripts": {
		"dev": "vite",
		"prepare": "npm run package && npm run build:elements",
		"build": "npm run package && npm run build:elements && npm run build:demo",
		"package": "svelte-package -i src/lib -o dist",
		"build:elements": "vite build -c vite.elements.config.ts",
		"build:demo": "vite build",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:targets": "playwright test -c tests/targets"
	},
	"peerDependencies": {
		"svelte": "^5.20.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.1",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	}
}
