{
	"name": "@mozra-the-great/kern",
	"version": "0.4.0",
	"description": "Svelte 5 component kit with brand themes set by CSS variables, also shipped as custom elements.",
	"license": "GPL-3.0-or-later",
	"author": "Mozra-the-great",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Mozra-the-great/kern.git"
	},
	"homepage": "https://mozra-the-great.github.io/kern/",
	"bugs": {
		"url": "https://github.com/Mozra-the-great/kern/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"customElements": "custom-elements.json",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./themes.css": "./dist/themes/index.css",
		"./themes/base.css": "./dist/themes/base.css",
		"./themes/stuffcloud.css": "./dist/themes/stuffcloud.css",
		"./themes/flower.css": "./dist/themes/flower.css",
		"./themes/pop.css": "./dist/themes/pop.css",
		"./themes/line.css": "./dist/themes/line.css",
		"./themes/*": "./dist/themes/*",
		"./elements": {
			"types": "./dist-elements/kern-elements.d.ts",
			"default": "./dist-elements/kern-elements.js"
		},
		"./elements/react": {
			"types": "./dist-elements/react.d.ts",
			"default": "./dist-elements/react.js"
		},
		"./elements/*": {
			"types": "./dist-elements/elements/*.d.ts",
			"default": "./dist-elements/elements/*.js"
		},
		"./custom-elements.json": "./custom-elements.json",
		"./assets/*": "./assets/*",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"dist-elements",
		"assets",
		"custom-elements.json",
		"NOTICE",
		"CHANGELOG.md"
	],
	"sideEffects": [
		"**/*.css",
		"./dist-elements/**/*.js"
	],
	"scripts": {
		"dev": "vite",
		"prepare": "npm run package && npm run build:elements",
		"build": "npm run package && npm run build:elements && npm run build:demo",
		"package": "svelte-package -i src/lib -o dist",
		"build:elements": "vite build -c vite.elements.config.ts --mode bundle && vite build -c vite.elements.config.ts --mode entries && node scripts/elements-manifest.mjs",
		"build:demo": "vite build",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write . && eslint . --fix",
		"test": "vitest run",
		"test:targets": "playwright test -c tests/targets",
		"test:elements": "playwright test -c tests/elements/playwright.config.ts",
		"test:types": "tsc --noEmit -p tests/fixtures/react-jsx",
		"test:consumer": "svelte-check --workspace tests/fixtures/strict-consumer --tsconfig ./tsconfig.json --fail-on-warnings && node tests/fixtures/strict-consumer/coverage.mjs",
		"check:dts": "node scripts/ci/no-any-dts.mjs",
		"size": "node scripts/ci/size-budget.mjs",
		"assets:check": "node scripts/ci/assets-drift.mjs",
		"assets:manifest": "node scripts/ci/assets-drift.mjs --write",
		"test:mascot": "playwright test -c tests/mascot/playwright.config.ts"
	},
	"peerDependencies": {
		"svelte": "^5.20.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"eslint": "^10.15.0",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	}
}
