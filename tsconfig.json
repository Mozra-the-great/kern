{
	"compilerOptions": {
		"target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
		"strict": true, "skipLibCheck": true, "verbatimModuleSyntax": true,
		"isolatedModules": true, "noEmit": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["svelte"]
	},
	"include": ["src/lib/**/*.ts", "src/lib/**/*.svelte", "src/demo/**/*.ts", "src/demo/**/*.svelte", "*.ts"]
}
